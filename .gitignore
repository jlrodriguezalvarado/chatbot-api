.cache/

# --- Documentación ---
_site/
docs/_build/

# --- Herramientas y gestores de dependencias ---
pip-wheel-metadata/
Pipfile.lock     # si prefieres no versionarlo (opcional)
poetry.lock      # idem, según tu flujo (opcional)

# --- IDEs / SO ---
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

